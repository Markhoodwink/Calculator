<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guideRootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0E17"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/viewDragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#334155" />

    <!-- Header bar: Title + Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvGuideTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖 Гайд и лайфхаки MB-CAL"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/viewHeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="#334155" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/layoutGuideContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Category 1: Лайфхаки ввода (CAS-дисплей) -->
            <TextView
                android:id="@+id/tvCategory1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="💡 Лайфхаки ввода (CAS-дисплей)"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Card 1.1: Курсор по касанию -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLifehack1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvLifehack1Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Курсор по касанию"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLifehack1Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="нажмите пальцем прямо в числитель, знаменатель, под корень или в степень — курсор мгновенно переместится туда без стрелок."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 1.2: Живой предрасчёт -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLifehack2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvLifehack2Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Живой предрасчёт"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLifehack2Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="при вводе выражения промежуточный ответ сразу отображается серым цветом справа снизу ещё до нажатия EXE =."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 1.3: Кнопка SHIFT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLifehack3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvLifehack3Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Кнопка SHIFT"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLifehack3Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="включает второй слой клавиш (sin⁻¹, cos⁻¹, tan⁻¹, eˣ, 10ˣ, ³√, x³, x⁻¹, константы CONST, x! и %)."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 1.4: Формат дробей (S⇔D) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLifehack4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvLifehack4Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Формат дробей (S⇔D)"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLifehack4Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="переключает ответ по кругу: обыкновенная дробь ↔ смешанная дробь ↔ десятичная дробь."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 1.5: Быстрые переменные -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLifehack5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvLifehack5Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Быстрые переменные"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLifehack5Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="при вводе букв (x, y, a...) над клавиатурой появляются чипы для мгновенной подстановки значений."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category 2: Все 7 режимов калькулятора -->
            <TextView
                android:id="@+id/tvCategory2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="🚀 Все 7 режимов калькулятора"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Mode 1: Вычисления (CAS) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMode1Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Вычисления (CAS)"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMode1Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="точная арифметика дробей, упрощение выражений и решение уравнений (⚡ Решить уравнение)."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 2: Системы уравнений -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMode2Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Системы уравнений"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMode2Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="решение систем от 2 до 5 уравнений методом подстановки с пошаговым разбором (кнопка След. переводит курсор на следующее уравнение)."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 3: Графики -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMode3Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Графики"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMode3Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="построение нескольких функций, поиск точек пересечения и таблица значений."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 4: Тригонометрия -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMode4Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Тригонометрия"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMode4Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="решение уравнений в радианах, отбор корней на отрезке [a; b], визуализация на окружности и пошаговый разбор (📖 Показать ход решения)."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 5: 3D Сечения -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMode5Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3D Сечения"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMode5Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="построение сечений по 3 точкам (вращение одним пальцем, масштаб двумя, привязка к вершинам и долям рёбер 1/2, 1/3, 2/3, 1/4, готовые задачи ЕГЭ)."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 6: Матрицы -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMode6Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Матрицы"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMode6Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="определитель det(A), обратная матрица A⁻¹, транспонирование и операции над матрицами."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 7: Конвертер величин -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMode7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMode7Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Конвертер величин"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMode7Desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="быстрый перевод длины, объёма, скорости, давления, данных и других физических величин."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
