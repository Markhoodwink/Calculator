<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardHistoryItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvItemTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <!-- Кликабельная формула (вставляет обратно в поле ввода калькулятора) -->
    <LinearLayout
        android:id="@+id/layoutItemExpression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvLabelExpression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Формула: "
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvItemExpression"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F1F5F9"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Кликабельный результат (подставляет в текущую позицию курсора) -->
    <LinearLayout
        android:id="@+id/layoutItemResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvLabelResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ответ: "
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvItemResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
