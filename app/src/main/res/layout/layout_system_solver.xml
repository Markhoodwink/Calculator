<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutSystemSolver"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnSystemBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="← РЕЖИМЫ"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSystemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Системы уравнений"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSystemClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Очистить"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- РАБОЧАЯ ОБЛАСТЬ (SCROLLVIEW) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollSystemSolver"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="12dp">

                <!-- КАРТОЧКА СПИСКА УРАВНЕНИЙ -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvEquationsSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Введите уравнения (например, x - y = 2):"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <!-- ДИНАМИЧЕСКИЙ КОНТЕЙНЕР СТРОК УРАВНЕНИЙ -->
                        <LinearLayout
                            android:id="@+id/containerEquationsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- КНОПКА ДОБАВИТЬ УРАВНЕНИЕ -->
                        <Button
                            style="@style/Widget.MaterialComponents.Button"
                            android:id="@+id/btnAddEquation"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#0F172A"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="+ Добавить уравнение"
                            android:textAllCaps="false"
                            android:textColor="#38BDF8"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:strokeColor="#334155"
                            app:strokeWidth="1dp" />

                        <!-- КНОПКА РЕШИТЬ СИСТЕМУ -->
                        <Button
                            style="@style/Widget.MaterialComponents.Button"
                            android:id="@+id/btnSolveSystemMain"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#059669"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="РЕШИТЬ СИСТЕМУ"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- КАРТОЧКА РЕЗУЛЬТАТА -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSystemResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#0284C7"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Результат:"
                                android:textColor="#94A3B8"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <Button
                                style="@style/Widget.MaterialComponents.Button"
                                android:id="@+id/btnCopySystemResult"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:backgroundTint="#0F172A"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:text="Копировать ответ"
                                android:textAllCaps="false"
                                android:textColor="#38BDF8"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:cornerRadius="6dp"
                                app:strokeColor="#334155"
                                app:strokeWidth="1dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSystemResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:text="Результат появится здесь"
                            android:textColor="#38BDF8"
                            android:textSize="18sp"
                            android:textIsSelectable="true"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/viewSystemStepsDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:background="#334155"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button"
                            android:id="@+id/btnToggleSystemSteps"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#0F172A"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:text="📖 Показать ход решения ▾"
                            android:textAllCaps="false"
                            android:textColor="#38BDF8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:cornerRadius="8dp"
                            app:strokeColor="#334155"
                            app:strokeWidth="1dp" />

                        <LinearLayout
                            android:id="@+id/layoutSystemStepsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="8dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/fabToggleSystemKeypad"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center"
            android:text="▼"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- ВСТРОЕННАЯ СВОРАЧИВАЕМАЯ КЛАВИАТУРА ВВОДА УРАВНЕНИЙ -->
    <LinearLayout
        android:id="@+id/layoutSystemKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0E17"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="6dp">

        <!-- Ряд 1: x y 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysVarX"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="x"
                android:textColor="#38BDF8"
                android:textSize="18sp"
                android:textStyle="italic|bold"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysVarY"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="y"
                android:textColor="#38BDF8"
                android:textSize="18sp"
                android:textStyle="italic|bold"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Ряд 2: z a 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysVarZ"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="z"
                android:textColor="#38BDF8"
                android:textSize="18sp"
                android:textStyle="italic|bold"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysVarA"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="a"
                android:textColor="#A78BFA"
                android:textSize="18sp"
                android:textStyle="italic|bold"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Ряд 3: b c 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysVarB"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="b"
                android:textColor="#A78BFA"
                android:textSize="18sp"
                android:textStyle="italic|bold"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysVarC"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1E293B"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="c"
                android:textColor="#A78BFA"
                android:textSize="18sp"
                android:textStyle="italic|bold"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Ряд 4: + − 0 . DEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysPlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#243042"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="+"
                android:textColor="#93C5FD"
                android:textSize="18sp"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#243042"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="−"
                android:textColor="#93C5FD"
                android:textSize="18sp"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSys0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysDot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysDel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#7F1D1D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:cornerRadius="6dp"
                android:text="DEL"
                android:textColor="#FCA5A5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Ряд 5 (Action & Operators Bar): ( ) ^ * / = След. РЕШИТЬ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnSysBracketOpen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#243042"
                android:insetTop="0dp"
                android:insetBottom="0dp"
