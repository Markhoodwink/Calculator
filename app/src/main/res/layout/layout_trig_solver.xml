<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutTrigSolver"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
    <LinearLayout
        android:id="@+id/layoutTrigHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnTrigBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="← РЕЖИМЫ"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrigTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Тригонометрия (ЕГЭ)"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTrigClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Очистить"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- РАБОЧАЯ ОБЛАСТЬ (SCROLLVIEW) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollTrigSolver"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <!-- КАРТОЧКА: ВВОД УРАВНЕНИЯ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTrigEquation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvTrigEqLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Уравнение:"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etTrigEquation"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_cas_input"
                            android:gravity="center_vertical"
                            android:hint="sin(x)^2 - 2sin(x) = 0"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="0dp"
                            android:text="sin(x)^2 - 2sin(x) = 0"
                            android:textColor="#F8FAFC"
                            android:textColorHint="#64748B"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- КАРТОЧКА: ОТБОРОЧНЫЙ ОТРЕЗОК [a; b] (ПУНКТ б) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTrigInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvTrigIntervalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Отрезок [a; b]:"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="["
                                android:textColor="#94A3B8"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etTrigIntervalStart"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/bg_cas_input"
                                android:gravity="center"
                                android:hint="π/2"
                                android:paddingHorizontal="6dp"
                                android:text="π/2"
                                android:textColor="#F8FAFC"
                                android:textColorHint="#64748B"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=";"
                                android:textColor="#94A3B8"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etTrigIntervalEnd"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/bg_cas_input"
                                android:gravity="center"
                                android:hint="π"
                                android:paddingHorizontal="6dp"
                                android:text="π"
                                android:textColor="#F8FAFC"
                                android:textColorHint="#64748B"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="]"
                                android:textColor="#94A3B8"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <Button
                                style="@style/Widget.MaterialComponents.Button"
                                android:id="@+id/btnTrigSolve"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:layout_marginStart="8dp"
                                android:backgroundTint="#38BDF8"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="РЕШИТЬ"
                                android:textColor="#0A0E17"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- КАРТОЧКА: ТРИГОНОМЕТРИЧЕСКАЯ ОКРУЖНОСТЬ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUnitCircle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/tvUnitCircleTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="2dp"
                            android:text="Тригонометрическая окружность:"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <com.example.calculator.UnitCircleView
                            android:id="@+id/unitCircleView"
                            android:layout_width="match_parent"
                            android:layout_height="175dp"
                            android:layout_marginTop="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- КАРТОЧКА: РЕШЕНИЕ (ПУНКТЫ а и б) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTrigResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#1E293B"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTrigResultHeader"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ответ:"
                                android:textColor="#94A3B8"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <Button
                                style="@style/Widget.MaterialComponents.Button"
                                android:id="@+id/btnCopyTrigResult"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:backgroundTint="#0F172A"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:text="Копировать"
                                android:textAllCaps="false"
                                android:textColor="#38BDF8"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:cornerRadius="6dp"
                                app:strokeColor="#334155"
                                app:strokeWidth="1dp" />
                        </LinearLayout>

                        <!-- Пункт а) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTrigResultTitleA"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="а)"
                                android:textColor="#38BDF8"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTrigResultA"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="x = πk, k ∈ ℤ"
                                android:textColor="#F8FAFC"
                                android:textIsSelectable="true"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Пункт б) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvTrigResultTitleB"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="б)"
                                android:textColor="#10B981"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTrigResultB"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="x₁ = π"
                                android:textColor="#F8FAFC"
                                android:textIsSelectable="true"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Разделитель и сворачиваемый блок хода решения -->
                        <View
                            android:id="@+id/viewStepsDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="#334155"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button"
                            android:id="@+id/btnToggleTrigSteps"
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:layout_marginTop="6dp"
                            android:backgroundTint="#0F172A"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:text="📖 Показать ход решения ▾"
                            android:textAllCaps="false"
                            android:textColor="#38BDF8"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            app:cornerRadius="8dp"
                            app:strokeColor="#334155"
                            app:strokeWidth="1dp" />

                        <LinearLayout
                            android:id="@+id/layoutTrigStepsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="6dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/fabToggleTrigKeypad"
            android:layout_width="44dp"
            android:layout_height="38dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center"
            android:text="▼"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- ВСТРОЕННАЯ СВОРАЧИВАЕМАЯ КЛАВИАТУРА ТРИГОНОМЕТРИИ -->
    <LinearLayout
        android:id="@+id/layoutTrigKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0E17"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="6dp">

        <!-- Ряд 1: sin( | cos( | 7 | 8 | 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrigSin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#243042"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="sin("
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrigCos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#243042"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="cos("
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrig7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrig8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrig9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Ряд 2: tan( | ctg( | 4 | 5 | 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrigTan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#243042"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="tan("
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrigCtg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#243042"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="ctg("
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrig4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrig5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrig6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Ряд 3: x | π | 1 | 2 | 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrigVarX"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#243042"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="x"
                android:textAllCaps="false"
                android:textColor="#F59E0B"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrigPi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#243042"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="π"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrig1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrig2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="6dp" />

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrig3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
                android:backgroundTint="#1A222D"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Ряд 4: √( | ^2 | 0 | . | ⌫ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.MaterialComponents.Button"
                android:id="@+id/btnTrigSqrt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1.5dp"
