<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Индикатор перетаскивания (Drag Handle) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#475569" />

    <!-- Заголовок -->
    <TextView
        android:id="@+id/tvConstantsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Физические константы (CONST)"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Нажмите для вставки значения в поле ввода"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#334155" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConstants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:scrollbars="vertical" />

</LinearLayout>
