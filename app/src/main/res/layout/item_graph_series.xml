<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="3dp">

    <!-- 1. КРУЖОК ВИДИМОСТИ (26dp) -->
    <View
        android:id="@+id/btnSeriesVisibility"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Видимость графика" />

    <!-- 2. ПОЛЕ ВВОДА ФОРМУЛЫ -->
    <EditText
        android:id="@+id/etSeriesFormula"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_weight="1"
        android:background="#1E293B"
        android:cursorVisible="true"
        android:gravity="center_vertical"
        android:hint="y = x^2 - 4, x^2 + y^2 = 16, y > x"
        android:paddingHorizontal="10dp"
        android:singleLine="true"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 3. КНОПКА УДАЛЕНИЯ ✕ -->
    <Button
        style="@style/Widget.MaterialComponents.Button"
        android:id="@+id/btnRemoveSeries"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:backgroundTint="#331A1A"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="✕"
        android:textColor="#EF4444"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="6dp" />
</LinearLayout>
